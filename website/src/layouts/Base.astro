---
import '../styles/global.css';
import { url } from '../lib/paths';
import { meta } from '../data/project';

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
}

const site = Astro.site?.toString().replace(/\/$/, '') ?? 'https://nicolasbecasazagra.github.io';
const pageTitle = Astro.props.title ? `${Astro.props.title} — ${meta.name}` : meta.name;
const description = Astro.props.description ?? meta.description;
const canonical = Astro.props.canonical ?? `${site}${Astro.url.pathname}`;
const ogImage = Astro.props.ogImage ?? `${site}${url('/og.png')}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0d0d0d" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f7f5f0" media="(prefers-color-scheme: light)" />
    <script is:inline>
      document.documentElement.classList.add('js-reveal');
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="manifest" href={url('/site.webmanifest')} />

    <link rel="preload" href={url('/fonts/martian-mono-latin.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={url('/fonts/jetbrains-mono-latin.woff2')} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={meta.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <slot />
  </body>
</html>
