---
import type { MarkdownHeading } from 'astro';
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { meta } from '../data/project';

interface Props {
  title: string;
  description?: string;
  source?: string;
  headings?: MarkdownHeading[];
  frontmatter?: Props;
}

const props = Astro.props.frontmatter ?? Astro.props;
const { title, description, source } = props;
const headings = Astro.props.headings ?? [];
const repoFileUrl = source ? `${meta.repo}/blob/main/${source}` : null;
---

<Base title={title} description={description}>
  <Nav />
  <main id="main" class="doc-page">
    <div class="doc-wrapper wrapper">
      <aside class="doc-toc" aria-label="Table of contents">
        <details class="toc-disclosure" open>
          <summary>
            <span class="toc-title">On this page</span>
          </summary>
          {headings.length > 0 ? (
            <nav aria-label="Document">
              <ol class="toc-list">
                {headings
                  .filter((h) => h.depth <= 3)
                  .map((h) => (
                    <li class={`toc-depth-${h.depth}`}>
                      <a href={`#${h.slug}`}>{h.text}</a>
                    </li>
                  ))}
              </ol>
            </nav>
          ) : (
            <p class="toc-empty">No headings found.</p>
          )}
        </details>
      </aside>

      <article class="doc-content">
        <header class="doc-header">
          <h1 class="doc-title">{title}</h1>
          {repoFileUrl && (
            <p class="doc-source">
              <a href={repoFileUrl} target="_blank" rel="noopener noreferrer">
                View the original in the repository
              </a>
            </p>
          )}
        </header>

        <div class="doc-body prose">
          <slot />
        </div>
      </article>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .doc-page {
    padding-block-start: 5rem;
    padding-block-end: var(--space-2xl);
  }

  .doc-wrapper {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: var(--space-xl);
    align-items: start;
  }

  .doc-toc {
    position: sticky;
    top: 5rem;
    max-height: calc(100svh - 7rem);
    overflow-y: auto;
  }

  .toc-disclosure {
    border: 1px solid var(--border);
    background: var(--paper-elevated);
  }

  .toc-disclosure summary {
    padding: var(--space-sm) var(--space-md);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    cursor: pointer;
    list-style: none;
  }

  .toc-disclosure summary::-webkit-details-marker {
    display: none;
  }

  .toc-list {
    list-style: none;
    padding: var(--space-sm) 0;
    margin: 0;
    border-top: 1px solid var(--border);
  }

  .toc-list li {
    margin: 0;
  }

  .toc-list a {
    display: block;
    padding: 0.35rem var(--space-md);
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: 1.35;
    text-decoration: none;
    border-inline-start: 2px solid transparent;
  }

  .toc-list a:hover {
    color: var(--text);
    background: var(--paper-sunk);
  }

  .toc-list a[aria-current='true'] {
    color: var(--accent);
    border-inline-start-color: var(--accent);
    background: var(--paper-sunk);
  }

  @media (prefers-color-scheme: dark) {
    .toc-list a[aria-current='true'] {
      color: var(--accent-on-dark);
      border-inline-start-color: var(--accent-on-dark);
    }
  }

  .toc-depth-3 {
    padding-inline-start: var(--space-md);
  }

  .toc-empty {
    padding: var(--space-sm) var(--space-md);
    font-size: var(--text-sm);
    color: var(--text-tertiary);
  }

  .doc-content {
    max-width: var(--measure);
  }

  .doc-header {
    margin-block-end: var(--space-xl);
    padding-block-end: var(--space-md);
    border-bottom: 1px solid var(--border);
  }

  .doc-title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    line-height: var(--leading-snug);
    font-weight: var(--font-bold);
    font-variation-settings: "wdth" var(--display-wdth), "wght" var(--display-wght);
    letter-spacing: -0.03em;
    text-transform: uppercase;
    margin-block-end: var(--space-sm);
    color: var(--text);
  }

  .doc-description {
    font-family: var(--font-body);
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
  }

  .doc-source {
    margin-block-start: var(--space-sm);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .doc-body {
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
  }

  .doc-body :global(h2) {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
    font-weight: var(--font-bold);
    font-variation-settings: "wdth" var(--display-wdth), "wght" var(--display-wght);
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: var(--text);
    margin-block: var(--space-xl) var(--space-sm);
    scroll-margin-top: 5rem;
  }

  .doc-body :global(h3) {
    font-family: var(--font-display);
    font-size: var(--text-headline);
    line-height: var(--leading-snug);
    font-weight: var(--font-bold);
    font-variation-settings: "wdth" var(--display-wdth), "wght" var(--display-wght);
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: var(--text);
    margin-block: var(--space-lg) var(--space-sm);
    scroll-margin-top: 5rem;
  }

  .doc-body :global(p) {
    margin-block-end: var(--space-md);
  }

  .doc-body :global(a) {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .doc-body :global(ul),
  .doc-body :global(ol) {
    margin-block-end: var(--space-md);
    padding-inline-start: 1.4rem;
  }

  .doc-body :global(li) {
    margin-block-end: var(--space-xs);
  }

  .doc-body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    padding: 0.15em 0.35em;
    background: var(--paper-sunk);
    color: var(--text);
  }

  .doc-body :global(pre) {
    padding: var(--space-md);
    border: 1px solid var(--border-strong);
    background: var(--paper);
    overflow-x: auto;
    margin-block-end: var(--space-md);
  }

  .doc-body :global(pre code) {
    padding: 0;
    background: transparent;
    font-size: var(--text-sm);
    line-height: var(--code-line-height);
  }

  .doc-body :global(table) {
    width: 100%;
    min-width: 560px;
    border-collapse: collapse;
    margin-block-end: var(--space-md);
    font-size: var(--text-sm);
    border-block: 1px solid var(--border-strong);
  }

  .doc-body :global(th),
  .doc-body :global(td) {
    padding: 0 var(--space-md);
    height: var(--row-height);
    text-align: left;
    border-bottom: 1px solid var(--border);
    vertical-align: middle;
  }

  .doc-body :global(thead th) {
    color: var(--text-tertiary);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: var(--text-xs);
  }

  .doc-body :global(blockquote) {
    margin-block-end: var(--space-md);
    padding: var(--space-md);
    border-inline-start: 3px solid var(--accent);
    background: var(--paper-elevated);
  }

  @media (prefers-color-scheme: dark) {
    .doc-body :global(blockquote) {
      border-color: var(--accent-on-dark);
    }
  }

  @media (max-width: 900px) {
    .doc-wrapper {
      grid-template-columns: 1fr;
    }

    .doc-toc {
      position: static;
      max-height: none;
      margin-block-end: var(--space-xl);
    }
  }
</style>

<script>
  function setupTocActiveState() {
    const toc = document.querySelector('.doc-toc');
    if (!toc) return;

    const links = toc.querySelectorAll('a[href^="#"]');
    const headings = Array.from(document.querySelectorAll('.doc-body [id]'));
    if (headings.length === 0) return;

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .map((e) => e.target.id)
          .filter(Boolean);
        if (visible.length === 0) return;

        const activeId = visible[0];
        links.forEach((link) => {
          const href = link.getAttribute('href')?.slice(1);
          link.setAttribute('aria-current', href === activeId ? 'true' : 'false');
        });
      },
      {
        rootMargin: '-20% 0px -60% 0px',
        threshold: 0,
      }
    );

    headings.forEach((h) => observer.observe(h));
  }

  setupTocActiveState();
  document.addEventListener('astro:page-load', setupTocActiveState);
</script>
