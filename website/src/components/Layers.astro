---
import { layers } from '../data/project';

const layerMap = new Map(layers.map((l) => [l.id, l]));

const kernel = layerMap.get('kernel')!;
const runtime = layerMap.get('runtime')!;
const agent = layerMap.get('agent')!;
const network = layerMap.get('network')!;
---

<section class="layers-section" aria-labelledby="layers-title">
  <div class="wrapper">
    <header class="section-header">
      <h2 id="layers-title" class="text-title">Four layers, one system</h2>
      <p class="text-lead">
        Each layer owns a single responsibility. Together they run a local model and let it act.
      </p>
    </header>

    <figure class="layers-figure">
      <figcaption id="layers-fig-title" class="sr-only">Architecture diagram</figcaption>
      <p id="layers-fig-desc" class="sr-only">
        The kernel supports the runtime. The runtime serves the model to the agent. The agent calls
        tools. The network layer lets the agent reach the host and external APIs.
      </p>

      <div class="diagram-scroll" tabindex="0" role="region" aria-label="Architecture diagram, scrollable on small screens">
        <svg
          class="layers-svg"
          viewBox="0 0 840 520"
          role="img"
          aria-labelledby="layers-fig-title layers-fig-desc"
          preserveAspectRatio="xMidYMid meet"
        >
          {/* Kernel box */}
          <g class="layer-box kernel">
            <rect x="260" y="360" width="320" height="80" rx="0" />
            <text x="270" y="386" class="layer-name">{kernel.name}</text>
            <text x="270" y="408" class="layer-role">{kernel.role}</text>
          </g>

          {/* Runtime box */}
          <g class="layer-box runtime">
            <rect x="260" y="200" width="320" height="80" rx="0" />
            <text x="270" y="226" class="layer-name">{runtime.name}</text>
            <text x="270" y="248" class="layer-role">{runtime.role}</text>
          </g>

          {/* Agent box */}
          <g class="layer-box agent">
            <rect x="260" y="40" width="320" height="80" rx="0" />
            <text x="270" y="66" class="layer-name">{agent.name}</text>
            <text x="270" y="88" class="layer-role">{agent.role}</text>
          </g>

          {/* Connection lines */}
          <line x1="420" y1="120" x2="420" y2="200" class="connector" />
          <line x1="420" y1="280" x2="420" y2="360" class="connector" />

          {/* Network pillar */}
          <g class="layer-box network">
            <rect x="640" y="40" width="160" height="400" rx="0" />
            <text x="720" y="66" text-anchor="middle" class="layer-name">{network.name}</text>
            <text x="720" y="88" text-anchor="middle" class="layer-role">{network.role}</text>
          </g>

          <line x1="580" y1="90" x2="640" y2="90" class="connector" />
          <line x1="580" y1="400" x2="640" y2="400" class="connector" />

          {/* Crate annotations */}
          <g class="crates">
            <text x="240" y="80" text-anchor="end" class="crate-label">madrust-agent</text>
            <text x="240" y="98" text-anchor="end" class="crate-label">madrust-http</text>

            <text x="240" y="240" text-anchor="end" class="crate-label">madrust-infer</text>
            <text x="240" y="258" text-anchor="end" class="crate-label">madrust-initramfs</text>

            <text x="240" y="420" text-anchor="end" class="crate-label">madrust-kernel</text>
            <text x="240" y="438" text-anchor="end" class="crate-label">madrust-mm · madrust-sched</text>
            <text x="240" y="456" text-anchor="end" class="crate-label">madrust-elf · madrust-drivers</text>

            <text x="810" y="420" text-anchor="end" class="crate-label">madrust-net</text>
            <text x="810" y="438" text-anchor="end" class="crate-label">madrust-netclient</text>
            <text x="810" y="456" text-anchor="end" class="crate-label">madrust-netstream · madrust-http</text>
          </g>
        </svg>
      </div>

      <div class="layers-text">
        {
          layers.map((layer) => (
            <div class="layer-detail">
              <h3>{layer.name}</h3>
              <p class="text-body">{layer.body}</p>
              <p class="layer-crates">
                Crates:{' '}
                {layer.crates.map((crate, i) => (
                  <>
                    <code>{crate}</code>
                    {i < layer.crates.length - 1 && ', '}
                  </>
                ))}
              </p>
            </div>
          ))
        }
      </div>
    </figure>
  </div>
</section>

<style>
  .layers-section {
    padding-block: var(--space-2xl);
  }

  .section-header {
    max-width: var(--measure);
    margin-block-end: var(--space-xl);
  }

  .section-header h2 {
    margin-block-end: var(--space-sm);
  }

  .layers-figure {
    margin: 0;
  }

  .diagram-scroll {
    overflow-x: auto;
    padding-block-end: var(--space-sm);
  }

  .layers-svg {
    min-width: 700px;
    width: 100%;
    height: auto;
    max-width: 840px;
    margin-inline: auto;
  }

  .layers-svg rect {
    fill: var(--paper-elevated);
    stroke: var(--border-strong);
    stroke-width: 1;
  }

  .layers-svg text {
    font-family: var(--font-body);
    font-size: 13px;
    fill: var(--text-secondary);
  }

  .layers-svg .layer-name {
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 700;
    font-variation-settings: "wdth" var(--display-wdth), "wght" var(--display-wght);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    fill: var(--text);
  }

  .layers-svg .layer-role {
    font-size: 13px;
    fill: var(--text-secondary);
  }

  .layers-svg .connector {
    stroke: var(--accent);
    stroke-width: 1.5;
  }

  @media (prefers-color-scheme: dark) {
    .layers-svg .connector {
      stroke: var(--accent-on-dark);
    }
  }

  .layers-svg .crate-label {
    font-family: var(--font-mono);
    font-size: 11px;
    fill: var(--text-tertiary);
  }

  .layers-text {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
    margin-block-start: var(--space-xl);
  }

  .layer-detail {
    padding: var(--space-md);
    border: 1px solid var(--border);
    background: var(--paper-elevated);
  }

  .layer-detail h3 {
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-weight: 700;
    font-variation-settings: "wdth" var(--display-wdth), "wght" var(--display-wght);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--text);
    margin-block-end: var(--space-xs);
  }

  .layer-detail .text-body {
    margin-block-end: var(--space-sm);
  }

  .layer-crates {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--text-tertiary);
  }

  .layer-crates code {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-secondary);
    background: var(--paper-sunk);
    padding: 0.1rem 0.25rem;
  }

  @media (max-width: 760px) {
    .layers-text {
      grid-template-columns: 1fr;
    }
  }
</style>
