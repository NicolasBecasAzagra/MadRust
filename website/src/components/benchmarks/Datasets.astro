---
import { benchmarkMethod } from '../../data/project';
---

<section class="datasets-section" aria-labelledby="datasets-title">
  <div class="wrapper">
    <header class="section-header">
      <h2 id="datasets-title" class="text-title">Raw results in the repository</h2>
      <p class="text-lead">
        Every measurement is committed as raw data. The published table is derived from these
        directories.
      </p>
    </header>

    <ul class="dataset-list">
      {
        benchmarkMethod.datasets.map((dataset) => (
          <li class="dataset-item">
            <code class="dataset-path">{dataset.path}</code>
            <span>{dataset.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .datasets-section {
    padding-block: var(--space-2xl);
    background: var(--paper-elevated);
    border-block: 1px solid var(--border);
  }

  .section-header {
    max-width: var(--measure);
    margin-block-end: var(--space-xl);
  }

  .section-header h2 {
    margin-block-end: var(--space-sm);
  }

  .dataset-list {
    display: grid;
    gap: var(--space-sm);
    list-style: none;
    padding: 0;
  }

  .dataset-item {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-md);
    padding: var(--space-sm) var(--space-md);
    border: 1px solid var(--border);
    background: var(--paper);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .dataset-path {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text);
  }
</style>
