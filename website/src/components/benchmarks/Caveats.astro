---
import { benchmarkCaveats, claims } from '../../data/project';
---

<section class="caveats-section" aria-labelledby="caveats-title">
  <div class="wrapper">
    <header class="section-header">
      <h2 id="caveats-title" class="text-title">What the numbers do and do not say</h2>
    </header>

    <div class="caveats-list">
      {
        benchmarkCaveats.map((caveat) => (
          <article class="caveat-item">
            <h3>{caveat.title}</h3>
            <p class="text-body">{caveat.body}</p>
          </article>
        ))
      }
    </div>

    <ul class="claims-list" aria-label="Claims that bound the benchmark results">
      {claims.map((claim) => <li>{claim}</li>)}
    </ul>
  </div>
</section>

<style>
  .caveats-section {
    padding-block: var(--space-2xl);
  }

  .section-header {
    max-width: var(--measure);
    margin-block-end: var(--space-xl);
  }

  .section-header h2 {
    margin-block-end: var(--space-sm);
  }

  .caveats-list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
    margin-block-end: var(--space-xl);
  }

  .caveat-item {
    padding: var(--space-md);
    border: 1px solid var(--border);
    background: var(--paper);
  }

  .caveat-item h3 {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    font-variation-settings: "wdth" var(--display-wdth), "wght" var(--display-wght);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text);
    margin-block-end: var(--space-xs);
  }

  .claims-list {
    list-style: none;
    padding: 0;
  }

  .claims-list li {
    position: relative;
    padding-inline-start: 1.4rem;
    margin-block-end: var(--space-sm);
    color: var(--text-secondary);
  }

  .claims-list li::before {
    content: '—';
    position: absolute;
    inset-inline-start: 0;
    color: var(--accent);
  }

  @media (prefers-color-scheme: dark) {
    .claims-list li::before {
      color: var(--accent-on-dark);
    }
  }

  @media (max-width: 760px) {
    .caveats-list {
      grid-template-columns: 1fr;
    }
  }
</style>
