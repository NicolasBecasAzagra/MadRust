---
import { url } from '../../lib/paths';
import { docs } from '../../data/project';

const primarySlugs = new Set(['architecture', 'report']);
const primaryDocs = docs.filter((doc) => primarySlugs.has(doc.slug));
const regularDocs = docs.filter((doc) => !primarySlugs.has(doc.slug));
---

<div class="docs-list" role="list">
  {
    primaryDocs.map((doc) => (
      <a class="docs-item docs-item-primary" href={url(`/docs/${doc.slug}`)} role="listitem">
        <span class="docs-marker" aria-hidden="true">→</span>
        <span class="docs-main">
          <span class="docs-title">{doc.title}</span>
          <span class="docs-summary">{doc.summary}</span>
        </span>
        <span class="docs-source">Read</span>
      </a>
    ))
  }

  {
    regularDocs.map((doc) => (
      <a class="docs-item" href={url(`/docs/${doc.slug}`)} role="listitem">
        <span class="docs-main">
          <span class="docs-title">{doc.title}</span>
          <span class="docs-summary">{doc.summary}</span>
        </span>
        <span class="docs-source">View source</span>
      </a>
    ))
  }
</div>

<section class="pipeline" aria-labelledby="pipeline-title">
  <h2 id="pipeline-title">How these pages stay in sync</h2>
  <p class="text-body">
    The documents live as Markdown in the repository. On every build, a script copies them into the
    site and renders them with the same layout. What you read here is the same file that lives in
    the repo.
  </p>
</section>

<style>
  .docs-list {
    border-top: 1px solid var(--border);
    margin-block-end: var(--space-xl);
  }

  .docs-item {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: var(--space-md);
    padding: var(--space-md) 0;
    border-bottom: 1px solid var(--border);
    color: inherit;
    text-decoration: none;
  }

  .docs-item:hover {
    background: var(--paper-elevated);
  }

  .docs-item-primary {
    grid-template-columns: auto 1fr auto;
    gap: var(--space-sm);
  }

  .docs-marker {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 500;
  }

  @media (prefers-color-scheme: dark) {
    .docs-marker {
      color: var(--accent-on-dark);
    }
  }

  .docs-main {
    display: grid;
    gap: var(--space-xs);
  }

  .docs-title {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: var(--font-bold);
    font-variation-settings: "wdth" var(--display-wdth), "wght" var(--display-wght);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--text);
  }

  .docs-item-primary .docs-title {
    color: var(--accent);
  }

  @media (prefers-color-scheme: dark) {
    .docs-item-primary .docs-title {
      color: var(--accent-on-dark);
    }
  }

  .docs-summary {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--leading-normal);
  }

  .docs-source {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .docs-item:hover .docs-source {
    color: var(--accent);
  }

  @media (prefers-color-scheme: dark) {
    .docs-item:hover .docs-source {
      color: var(--accent-on-dark);
    }
  }

  .pipeline {
    padding: var(--space-md);
    border: 1px solid var(--border);
    background: var(--paper-elevated);
  }

  .pipeline h2 {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: var(--font-bold);
    font-variation-settings: "wdth" var(--display-wdth), "wght" var(--display-wght);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    margin-block-end: var(--space-sm);
    color: var(--text);
  }

  .pipeline .text-body {
    margin: 0;
    max-width: var(--measure);
  }

  @media (max-width: 760px) {
    .docs-item,
    .docs-item-primary {
      grid-template-columns: 1fr;
      gap: var(--space-xs);
    }

    .docs-source {
      justify-self: start;
    }
  }
</style>
