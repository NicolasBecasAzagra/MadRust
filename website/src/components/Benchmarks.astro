---
import { benchmarks, benchmarkMethod, benchmarkCaveats, claims, meta } from '../data/project';
import { url } from '../lib/paths';

const groups = {
  operation: 'Kernel operations',
  inference: 'Inference',
  agent: 'Agent loop',
} as const;

const grouped = benchmarks.reduce<Record<string, typeof benchmarks>>((acc, b) => {
  (acc[b.group] ??= []).push(b);
  return acc;
}, {});
---

<section class="benchmarks-section" aria-labelledby="benchmarks-title">
  <div class="wrapper">
    <header class="section-header">
      <p class="section-eyebrow">Measurements</p>
      <h2 id="benchmarks-title" class="text-title">The numbers, with the losses</h2>
      <p class="text-lead">
        Every measurement is published, including the cases where mainline wins. The comparison
        point is Linux 7.3.0, with and without mitigations, on the same QEMU rig.
      </p>
    </header>

    <div class="method-card">
      <p class="method-headline">{benchmarkMethod.headline}</p>
      <p class="text-body">{benchmarkMethod.detail}</p>
    </div>

    <div class="tables-stack">
      {
        Object.entries(grouped).map(([group, rows]) => (
          <div class="benchmark-group">
            <h3 class="group-title">{groups[group as keyof typeof groups]}</h3>
            <div class="table-wrap">
              <table>
                <colgroup>
                  <col class="col-metric" />
                  <col class="col-value" />
                  <col class="col-value" />
                  <col class="col-value" />
                </colgroup>
                <thead>
                  <tr>
                    <th scope="col">Metric</th>
                    <th scope="col">MadRust</th>
                    <th scope="col">Linux 7.3.0</th>
                    <th scope="col">Linux, no mitigations</th>
                  </tr>
                </thead>
                <tbody>
                  {rows.map((row) => (
                    <tr>
                      <th scope="row">{row.metric}</th>
                      <td class="value highlight">{row.madrust}</td>
                      <td class="value">{row.mainline}</td>
                      <td class="value">{row.mainlineNoMitigations}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        ))
      }
    </div>

    <div class="caveats-grid">
      {
        benchmarkCaveats.map((caveat) => (
          <article class="caveat-card">
            <h3>{caveat.title}</h3>
            <p class="text-body">{caveat.body}</p>
          </article>
        ))
      }
    </div>

    <ul class="claims-list">
      {claims.map((claim) => <li>{claim}</li>)}
    </ul>

    <p class="report-link">
      <a class="button button-secondary" href={`${meta.repo}/blob/main/REPORT.md`}>
        Read the full report
      </a>
      <a class="button button-secondary" href={url('/benchmarks')}>Explore all benchmarks</a>
    </p>
  </div>
</section>

<style>
  .benchmarks-section {
    padding-block: var(--space-2xl);
    background: var(--bg-sunk);
    border-block: 1px solid var(--border);
  }

  .method-card {
    max-width: var(--measure);
    margin-block-end: var(--space-xl);
    padding: var(--space-md);
    border-radius: var(--radius-lg);
    background: var(--bg-elevated);
    border: 1px solid var(--border);
  }

  .section-eyebrow {
    margin-block-end: var(--space-sm);
    color: var(--text-tertiary);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
  }

  .method-headline {
    font-size: var(--text-lg);
    font-weight: var(--font-semibold);
    color: var(--text);
    margin-block-end: var(--space-xs);
  }

  .tables-stack {
    display: grid;
    gap: var(--space-xl);
    margin-block-end: var(--space-xl);
  }

  .benchmark-group {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .group-title {
    padding: var(--space-md) var(--space-md) 0;
    font-size: var(--text-lg);
    font-weight: var(--font-semibold);
  }

  .table-wrap {
    overflow-x: auto;
  }

  table {
    width: 100%;
    min-width: 640px;
    table-layout: fixed;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  .col-metric {
    width: 46%;
  }

  .col-value {
    width: 18%;
  }

  thead th {
    padding: var(--space-sm) var(--space-md);
    text-align: left;
    font-weight: var(--font-medium);
    color: var(--text-secondary);
    border-bottom: 1px solid var(--border);
    white-space: nowrap;
  }

  tbody th,
  tbody td {
    padding: var(--space-sm) var(--space-md);
    border-bottom: 1px solid var(--border);
    vertical-align: top;
  }

  tbody tr:last-child th,
  tbody tr:last-child td {
    border-bottom: none;
  }

  tbody th {
    font-weight: var(--font-medium);
    color: var(--text);
    text-align: left;
  }

  .value {
    font-family: var(--font-mono);
    color: var(--text-secondary);
    white-space: nowrap;
  }

  .value.highlight {
    color: var(--accent);
    font-weight: var(--font-medium);
  }

  @media (prefers-color-scheme: dark) {
    .value.highlight {
      color: var(--accent-on-dark);
    }
  }

  .caveats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
    margin-block-end: var(--space-xl);
  }

  .caveat-card {
    padding: var(--space-md);
    border-radius: var(--radius);
    background: var(--bg-elevated);
    border: 1px solid var(--border);
  }

  .caveat-card h3 {
    font-size: var(--text-base);
    font-weight: var(--font-semibold);
    margin-block-end: var(--space-xs);
  }

  .claims-list {
    list-style: none;
    padding: 0;
    margin-block-end: var(--space-xl);
  }

  .claims-list li {
    position: relative;
    padding-inline-start: 1.4rem;
    margin-block-end: var(--space-sm);
    color: var(--text-secondary);
  }

  .claims-list li::before {
    content: '—';
    position: absolute;
    inset-inline-start: 0;
    color: var(--text-tertiary);
  }

  .report-link {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  @media (max-width: 760px) {
    .caveats-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
