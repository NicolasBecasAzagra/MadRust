---
import { url } from '../lib/paths';
import { meta } from '../data/project';

const footerLinks = [
  { label: 'Roadmap', href: url('/roadmap') },
  { label: 'Benchmarks', href: url('/benchmarks') },
  { label: 'Docs', href: url('/docs') },
  { label: 'Download', href: url('/download') },
  { label: 'Changelog', href: url('/changelog') },
  { label: 'FAQ', href: url('/faq') },
];
---

<footer class="site-footer">
  <div class="wrapper footer-inner">
    <div class="footer-rule" aria-hidden="true"></div>
    <div class="footer-grid">
      <div class="footer-brand">
        <p class="footer-name">{meta.name}</p>
        <p class="footer-status">{meta.status}</p>
      </div>

      <nav class="footer-nav" aria-label="Footer">
        <ul>
          {footerLinks.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
        </ul>
      </nav>

      <div class="footer-meta">
        <p><a href={meta.repo}>Source on GitHub</a></p>
        <p><a href={meta.licenseUrl}>Licensed {meta.license}</a></p>
        <p>Built by {meta.author}</p>
        <p><a href={`${meta.repo}/blob/main/REPORT.md`}>Measurement report</a></p>
      </div>
    </div>

    <p class="footer-disclaimer">This is a research kernel, not a production operating system.</p>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-xl) var(--space-lg);
    margin-block-start: var(--space-2xl);
  }

  .footer-rule {
    height: 1px;
    background: var(--border-strong);
    margin-block-end: var(--space-lg);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1.4fr;
    gap: var(--space-lg);
  }

  .footer-name {
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-weight: var(--font-bold);
    font-variation-settings: "wdth" var(--display-wdth), "wght" var(--display-wght);
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .footer-status {
    margin-block-start: var(--space-xs);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--text-tertiary);
  }

  .footer-nav ul {
    display: grid;
    gap: var(--space-xs);
    list-style: none;
    padding: 0;
  }

  .footer-nav a {
    color: var(--text-secondary);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .footer-nav a:hover {
    color: var(--text);
    text-decoration: underline;
  }

  .footer-meta p {
    margin-block-start: var(--space-xs);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--text-tertiary);
  }

  .footer-meta a {
    color: var(--text-secondary);
    text-decoration: none;
  }

  .footer-meta a:hover {
    color: var(--text);
    text-decoration: underline;
  }

  .footer-disclaimer {
    margin-block-start: var(--space-xl);
    padding-block-start: var(--space-md);
    border-top: 1px solid var(--border);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--text-tertiary);
  }

  @media (max-width: 760px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }
  }
</style>
