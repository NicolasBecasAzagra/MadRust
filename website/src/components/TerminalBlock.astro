---
export interface Props {
  code: string;
  label: string;
  showCopy?: boolean;
}

const { code, label, showCopy = true } = Astro.props;
const blockId = `term-${Math.random().toString(36).slice(2, 9)}`;
---

<figure class="terminal-block" aria-label={label}>
  <figcaption class="terminal-header">
    <span class="terminal-label">{label}</span>
    {
      showCopy && (
        <button
          type="button"
          class="terminal-copy"
          data-copy-target={blockId}
          aria-label={`Copy ${label} to clipboard`}
        >
          <span class="copy-text" aria-hidden="false">Copy</span>
        </button>
      )
    }
  </figcaption>
  <pre id={blockId} tabindex="0"><code>{code}</code></pre>
</figure>

<script>
  function copyText(text: string): Promise<void> {
    if (navigator.clipboard && window.isSecureContext) {
      return navigator.clipboard.writeText(text);
    }
    return new Promise((resolve, reject) => {
      const textarea = document.createElement('textarea');
      textarea.value = text;
      textarea.style.position = 'fixed';
      textarea.style.left = '-9999px';
      textarea.setAttribute('aria-hidden', 'true');
      document.body.appendChild(textarea);
      textarea.focus();
      textarea.select();
      try {
        const ok = document.execCommand('copy');
        document.body.removeChild(textarea);
        if (ok) resolve();
        else reject(new Error('execCommand returned false'));
      } catch (err) {
        document.body.removeChild(textarea);
        reject(err);
      }
    });
  }

  function setupCopyButtons() {
    document.querySelectorAll('.terminal-copy').forEach((button) => {
      if (button.hasAttribute('data-copy-bound')) return;
      button.setAttribute('data-copy-bound', 'true');
      button.addEventListener('click', async () => {
        const targetId = button.getAttribute('data-copy-target');
        const pre = targetId ? document.getElementById(targetId) : null;
        const code = pre?.querySelector('code');
        if (!code) return;
        try {
          await copyText(code.textContent || '');
          const text = button.querySelector('.copy-text');
          if (text) {
            const original = text.textContent || 'Copy';
            text.textContent = 'Copied';
            button.setAttribute('aria-label', 'Copied to clipboard');
            setTimeout(() => {
              text.textContent = original;
              button.setAttribute('aria-label', `Copy ${button.closest('.terminal-block')?.getAttribute('aria-label') || 'command'} to clipboard`);
            }, 1500);
          }
        } catch {
          const text = button.querySelector('.copy-text');
          if (text) {
            const original = text.textContent || 'Copy';
            text.textContent = 'Failed';
            setTimeout(() => {
              text.textContent = original;
            }, 1500);
          }
        }
      });
    });
  }

  setupCopyButtons();
  document.addEventListener('astro:page-load', setupCopyButtons);
</script>

<style>
  .terminal-block {
    margin: 0;
    border: 1px solid var(--border-strong);
    background: var(--paper);
  }

  .terminal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    border-bottom: 1px solid var(--border);
    background: var(--paper-elevated);
  }

  .terminal-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .terminal-copy {
    padding: 0.3rem 0.65rem;
    border: 1px solid var(--border);
    background: var(--paper);
    color: var(--text-secondary);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .terminal-copy:hover {
    background: var(--paper-sunk);
    color: var(--text);
    border-color: var(--border-strong);
  }

  .terminal-copy:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px var(--bg), 0 0 0 4px var(--ring);
  }

  pre {
    padding: var(--space-md);
    margin: 0;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: var(--code-line-height);
    color: var(--text);
    background: var(--paper);
  }

  pre:focus-visible {
    outline: none;
    box-shadow: inset 0 0 0 2px var(--ring);
  }

  code {
    font-family: inherit;
    white-space: pre;
  }
</style>
