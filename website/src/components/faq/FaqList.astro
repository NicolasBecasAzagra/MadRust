---
export interface Props {
  items: { question: string; answer: string }[];
}

const { items } = Astro.props;
---

<div class="faq-list">
  {
    items.map((item, index) => (
      <details class="faq-item" id={`faq-${index}`}>
        <summary>
          <span class="faq-marker" aria-hidden="true">+</span>
          <span class="faq-question">{item.question}</span>
        </summary>
        <div class="faq-answer">
          <p>{item.answer}</p>
        </div>
      </details>
    ))
  }
</div>

<style>
  .faq-list {
    border-top: 1px solid var(--border);
  }

  .faq-item {
    border-bottom: 1px solid var(--border);
  }

  .faq-item summary {
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
    padding: var(--space-md) 0;
    font-family: var(--font-mono);
    font-size: var(--text-base);
    line-height: var(--leading-normal);
    color: var(--text);
    cursor: pointer;
    list-style: none;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item summary:hover .faq-question {
    color: var(--accent);
  }

  @media (prefers-color-scheme: dark) {
    .faq-item summary:hover .faq-question {
      color: var(--accent-on-dark);
    }
  }

  .faq-marker {
    flex: none;
    color: var(--accent);
    font-weight: 500;
    width: 1rem;
    text-align: center;
  }

  @media (prefers-color-scheme: dark) {
    .faq-marker {
      color: var(--accent-on-dark);
    }
  }

  .faq-item[open] .faq-marker {
    transform: rotate(45deg);
  }

  .faq-answer {
    padding: 0 0 var(--space-md) calc(1rem + var(--space-sm));
    max-width: var(--measure);
  }

  .faq-answer p {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--text-secondary);
  }
</style>

<script>
  function setupFaqAccordions() {
    const lists = document.querySelectorAll('.faq-list');
    lists.forEach((list) => {
      const items = list.querySelectorAll('.faq-item');
      items.forEach((item) => {
        const summary = item.querySelector('summary');
        summary?.addEventListener('click', (event) => {
          const isOpen = item.hasAttribute('open');
          items.forEach((other) => {
            if (other !== item) other.removeAttribute('open');
          });
          if (isOpen) {
            event.preventDefault();
            item.removeAttribute('open');
          }
        });
      });
    });
  }

  setupFaqAccordions();
  document.addEventListener('astro:page-load', setupFaqAccordions);
</script>
