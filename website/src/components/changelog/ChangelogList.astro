---
import { getCommitsByMonth } from '../../lib/changelog';
import { meta } from '../../data/project';

const grouped = getCommitsByMonth(80);
const repoCommitUrl = `${meta.repo}/commit`;

function formatMonth(monthKey: string): string {
  const date = new Date(`${monthKey}-01T00:00:00`);
  return date.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
}

function formatDate(iso: string): string {
  return new Date(iso).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
}
---

{
  grouped.length === 0 ? (
    <div class="empty-state">
      <p class="text-headline">No commit history available</p>
      <p class="text-body">
        The changelog is built from the repository at build time. If you are reading a preview
        without git, or the history could not be read, this page stays empty instead of inventing
        entries.
      </p>
      <p class="text-body">
        <a href={meta.repo}>View the repository on GitHub</a> for the real history.
      </p>
    </div>
  ) : (
    <div class="changelog-log">
      {grouped.map(({ month, commits }) => (
        <section class="month-group" aria-labelledby={`month-${month}`}>
          <h2 id={`month-${month}`} class="month-heading">
            {formatMonth(month)}
          </h2>
          <ol class="commit-list">
            {commits.map((commit) => (
              <li class="commit-item">
                <a
                  class="commit-hash"
                  href={`${repoCommitUrl}/${commit.hash}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Commit ${commit.short}`}
                >
                  <code>{commit.short}</code>
                </a>
                <span class="commit-type">{commit.type}</span>
                {commit.scope && <span class="commit-scope">{commit.scope}</span>}
                <span class="commit-subject">{commit.subject}</span>
                <time class="commit-date" datetime={commit.date}>
                  {formatDate(commit.date)}
                </time>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>
  )
}

<style>
  .empty-state {
    padding: var(--space-xl);
    border: 1px solid var(--border);
    background: var(--paper-elevated);
  }

  .empty-state .text-headline {
    margin-block-end: var(--space-sm);
  }

  .changelog-log {
    display: grid;
    gap: var(--space-xl);
  }

  .month-group {
    display: grid;
    gap: var(--space-sm);
  }

  .month-heading {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: var(--font-bold);
    font-variation-settings: "wdth" var(--display-wdth), "wght" var(--display-wght);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--text);
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--border-strong);
  }

  .commit-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .commit-item {
    display: grid;
    grid-template-columns: auto auto auto 1fr auto;
    align-items: baseline;
    gap: var(--space-sm);
    min-height: var(--row-height);
    padding: 0 var(--space-sm);
    border-bottom: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .commit-item:hover {
    background: var(--paper-elevated);
  }

  .commit-hash {
    color: var(--text-tertiary);
    text-decoration: none;
    font-family: var(--font-mono);
  }

  .commit-hash:hover {
    color: var(--accent);
  }

  @media (prefers-color-scheme: dark) {
    .commit-hash:hover {
      color: var(--accent-on-dark);
    }
  }

  .commit-hash code {
    font-family: inherit;
    background: transparent;
    padding: 0;
  }

  .commit-type {
    color: var(--text-secondary);
    text-transform: lowercase;
  }

  .commit-type::before {
    content: '[';
    color: var(--text-tertiary);
  }

  .commit-type::after {
    content: ']';
    color: var(--text-tertiary);
  }

  .commit-scope {
    color: var(--text-tertiary);
  }

  .commit-scope::before {
    content: '(';
    color: var(--text-tertiary);
  }

  .commit-scope::after {
    content: ')';
    color: var(--text-tertiary);
  }

  .commit-subject {
    color: var(--text);
    line-height: var(--leading-normal);
  }

  .commit-date {
    color: var(--text-tertiary);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  @media (max-width: 760px) {
    .commit-item {
      grid-template-columns: auto 1fr auto;
      grid-template-rows: auto auto;
      gap: var(--space-xs) var(--space-sm);
      padding: var(--space-sm);
    }

    .commit-hash {
      grid-row: 1;
      grid-column: 1;
    }

    .commit-subject {
      grid-row: 1;
      grid-column: 2;
      white-space: normal;
    }

    .commit-date {
      grid-row: 1;
      grid-column: 3;
    }

    .commit-type,
    .commit-scope {
      grid-row: 2;
      grid-column: 2;
    }
  }
</style>
