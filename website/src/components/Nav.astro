---
import { url } from '../lib/paths';
import { meta } from '../data/project';

const links = [
  { label: 'Roadmap', href: url('/roadmap') },
  { label: 'Benchmarks', href: url('/benchmarks') },
  { label: 'Docs', href: url('/docs') },
  { label: 'Download', href: url('/download') },
  { label: 'FAQ', href: url('/faq') },
];
---

<header class="site-header">
  <div class="wrapper header-inner">
    <a class="wordmark" href={url('/')} aria-label={`${meta.name} home`}>
      <svg class="wordmark-icon" viewBox="0 0 32 32" width="28" height="28" aria-hidden="true">
        <rect x="2" y="10" width="28" height="12" rx="2" fill="currentColor"></rect>
        <rect x="6" y="14" width="6" height="4" rx="1" fill="var(--bg)"></rect>
        <rect x="14" y="14" width="12" height="1" fill="var(--bg)"></rect>
        <rect x="14" y="17" width="8" height="1" fill="var(--bg)"></rect>
      </svg>
      <span class="wordmark-text">{meta.name}</span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      <ul class="nav-list">
        {
          links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      <a class="button button-secondary button-small" href={url('/docs')}>Read the docs</a>
      <a class="button button-primary button-small" href={meta.repo}>GitHub</a>
    </div>

    <button
      class="menu-toggle"
      aria-expanded="false"
      aria-controls="primary-menu"
      aria-label="Open menu"
    >
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: 100;
    background: rgba(248, 248, 250, 0.82);
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
    backdrop-filter: blur(12px) saturate(180%);
    -webkit-backdrop-filter: blur(12px) saturate(180%);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.04);
    transition: background-color 200ms ease, border-color 200ms ease, box-shadow 200ms ease;
  }

  @media (prefers-color-scheme: dark) {
    .site-header {
      background: rgba(26, 26, 26, 0.82);
      border-bottom-color: rgba(255, 255, 255, 0.12);
      box-shadow: 0 4px 24px rgba(0, 0, 0, 0.25);
    }
  }

  @supports not (backdrop-filter: blur(12px)) {
    .site-header {
      background: var(--bg);
    }
  }

  .site-header.scrolled {
    box-shadow: var(--shadow-sm);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space);
    height: 4rem;
  }

  .wordmark {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    color: var(--text);
    font-weight: var(--font-semibold);
    font-size: var(--text-lg);
    letter-spacing: -0.02em;
  }

  .wordmark:hover {
    color: var(--text);
  }

  .wordmark-icon {
    flex: none;
    color: var(--text-secondary);
  }

  .nav-list {
    display: flex;
    gap: var(--space-sm);
    list-style: none;
    padding: 0;
  }

  .nav-list a {
    display: block;
    padding: 0.35rem 0.7rem;
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
  }

  .nav-list a:hover {
    color: var(--text);
    background: var(--bg-sunk);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .button-small {
    padding: 0.55rem 1rem;
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
  }

  .menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }

  .menu-toggle span {
    display: block;
    width: 1.1rem;
    height: 1.5px;
    margin-inline: auto;
    background: var(--text);
    transition: transform 150ms ease;
  }

  @media (max-width: 820px) {
    .site-nav,
    .header-actions {
      display: none;
    }

    .site-header.open .site-nav {
      display: block;
      position: absolute;
      inset-block-start: calc(100% + var(--space-sm));
      inset-inline: var(--space);
      background: var(--bg-elevated);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: var(--space);
      box-shadow: var(--shadow-sm);
    }

    .site-header.open .header-actions {
      display: flex;
      position: absolute;
      inset-block-start: calc(100% + 12.5rem);
      inset-inline: var(--space);
      justify-content: flex-start;
      background: var(--bg-elevated);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: var(--space);
      box-shadow: var(--shadow-sm);
    }

    .site-header.open .nav-list {
      flex-direction: column;
      width: 100%;
    }

    .menu-toggle {
      display: flex;
    }
  }
</style>

<script>
  const header = document.querySelector('.site-header');
  const toggle = header?.querySelector('.menu-toggle');
  const nav = header?.querySelector('.site-nav');

  function updateScroll() {
    if (!header) return;
    if (window.scrollY > 8) {
      header.classList.add('scrolled');
    } else {
      header.classList.remove('scrolled');
    }
  }

  window.addEventListener('scroll', updateScroll, { passive: true });
  updateScroll();

  toggle?.addEventListener('click', () => {
    const open = header?.classList.toggle('open');
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    if (nav) nav.id = 'primary-menu';
  });
</script>
