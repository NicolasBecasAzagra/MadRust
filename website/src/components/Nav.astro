---
import { url } from '../lib/paths';
import { meta } from '../data/project';

const links = [
  { label: 'Roadmap', href: url('/roadmap') },
  { label: 'Benchmarks', href: url('/benchmarks') },
  { label: 'Docs', href: url('/docs') },
  { label: 'Download', href: url('/download') },
  { label: 'FAQ', href: url('/faq') },
  { label: 'Changelog', href: url('/changelog') },
];
---

<header class="site-header">
  <div class="wrapper header-inner">
    <a class="wordmark" href={url('/')} aria-label={`${meta.name} home`}>
      <svg class="wordmark-icon" viewBox="0 0 32 32" width="24" height="24" aria-hidden="true">
        <rect x="4" y="5" width="24" height="22" rx="1" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"/>
        <line x1="8" y1="12" x2="24" y2="12" stroke="currentColor" stroke-width="2" stroke-linecap="square"/>
        <line x1="8" y1="17" x2="18" y2="17" stroke="currentColor" stroke-width="2" stroke-linecap="square"/>
      </svg>
      <span class="wordmark-text">{meta.name}</span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      <ul class="nav-list">
        {
          links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      <a class="button button-secondary button-small" href={url('/docs')}>Docs</a>
      <a class="button button-primary button-small" href={meta.repo}>GitHub</a>
    </div>

    <details class="mobile-menu">
      <summary class="menu-toggle" aria-label="Menu">
        <span></span>
        <span></span>
      </summary>
      <div class="mobile-menu-panel">
        <div class="wrapper">
          <ul class="mobile-nav-list">
            {
              links.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))
            }
          </ul>
          <div class="mobile-actions">
            <a class="button button-secondary" href={url('/docs')}>Docs</a>
            <a class="button button-primary" href={meta.repo}>GitHub</a>
          </div>
        </div>
      </div>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: 100;
    background: var(--paper);
    border-bottom: 1px solid var(--border-strong);
  }

  .header-inner {
    position: relative;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space);
    height: 3.5rem;
  }

  .wordmark {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    color: var(--text);
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-weight: var(--font-bold);
    font-variation-settings: "wdth" var(--display-wdth), "wght" var(--display-wght);
    letter-spacing: -0.03em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .wordmark:hover {
    color: var(--text);
  }

  .wordmark-icon {
    flex: none;
    color: var(--text-secondary);
  }

  .site-nav {
    display: flex;
  }

  .nav-list {
    display: flex;
    gap: var(--space-xs);
    list-style: none;
    padding: 0;
  }

  .nav-list a {
    display: block;
    padding: 0.35rem 0.5rem;
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .nav-list a:hover {
    color: var(--text);
    background: var(--paper-sunk);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .button-small {
    padding: 0.45rem 0.75rem;
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    background: transparent;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
  }

  .menu-toggle span {
    display: block;
    width: 1.1rem;
    height: 1.5px;
    background: var(--text);
    transition: transform 150ms ease;
  }

  .mobile-menu {
    display: none;
  }

  .mobile-menu summary {
    list-style: none;
  }

  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  .mobile-menu-panel {
    position: absolute;
    inset-block-start: 3.5rem;
    inset-inline: 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border-strong);
    background: var(--paper);
    padding-block: var(--space-md);
  }

  .mobile-nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-xs);
    margin-block-end: var(--space-md);
  }

  .mobile-nav-list a {
    display: block;
    padding: var(--space-sm) 0;
    color: var(--text);
    font-family: var(--font-body);
    font-size: var(--text-base);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    border-bottom: 1px solid var(--border);
  }

  .mobile-actions {
    display: flex;
    gap: var(--space-sm);
  }

  @media (max-width: 900px) {
    .site-nav,
    .header-actions {
      display: none;
    }

    .mobile-menu {
      display: block;
    }
  }
</style>
