---
import { milestones } from '../data/project';
import { url } from '../lib/paths';

const stateLabel: Record<string, string> = {
  done: 'Done',
  next: 'Next',
  deferred: 'Deferred',
};

const phases = [
  {
    title: 'Kernel and memory',
    ids: ['M0', 'M1', 'M2', 'M2b', 'M2c', 'M3'],
  },
  {
    title: 'Userspace and paging',
    ids: ['M4', 'M4b', 'M4c', 'E1', 'E2', 'E2b', 'E3a', 'E3b'],
  },
  {
    title: 'Parallelism and network',
    ids: ['M9', 'M10', 'M12'],
  },
  {
    title: 'Inference, agent and measurement',
    ids: ['E4', 'E5', 'E6', 'E7', 'E8', 'M8', 'M11', 'M13'],
  },
];

const deferredIds = ['M5', 'M6', 'M7'];

const byId = new Map(milestones.map((m) => [m.id, m]));

const activeNextId = phases
  .flatMap((p) => p.ids)
  .find((id) => byId.get(id)?.state === 'next');
---

<section class="milestones-section" aria-labelledby="milestones-title">
  <div class="wrapper">
    <header class="section-header">
      <h2 id="milestones-title" class="text-title">A ladder of exit criteria</h2>
      <p class="text-lead">
        Every milestone ends with a sentence a machine can check. No hand-waving, no “almost done”.
      </p>
    </header>

    <div class="phases">
      {
        phases.map((phase) => (
          <section class="phase">
            <h3 class="phase-title">{phase.title}</h3>
            <ol class="milestone-list">
              {phase.ids.map((id) => {
                const m = byId.get(id);
                if (!m) return null;
                const isActiveNext = m.state === 'next' && m.id === activeNextId;
                const stateIcon = m.state === 'done' ? '✓' : m.state === 'next' ? '→' : '—';
                return (
                  <li class={`milestone-item state-${m.state} ${isActiveNext ? 'is-active-next' : ''}`}>
                    <details class="milestone-details">
                      <summary>
                        <span class="milestone-id">{m.id}</span>
                        <span class="milestone-name">{m.name}</span>
                        <span class="milestone-state" aria-label={`State: ${stateLabel[m.state]}`}>
                          <span class="state-icon" aria-hidden="true">{stateIcon}</span>
                          <span class="state-text">{stateLabel[m.state]}</span>
                        </span>
                      </summary>
                      <div class="milestone-body">
                        <p class="delivers">{m.delivers}</p>
                        {m.exit && (
                          <p class="criterion">
                            <span>Exit:</span> {m.exit}
                          </p>
                        )}
                        {m.verification && (
                          <p class="criterion">
                            <span>Verification:</span> {m.verification}
                          </p>
                        )}
                      </div>
                    </details>
                  </li>
                );
              })}
            </ol>
          </section>
        ))
      }

      <section class="phase phase-deferred">
        <h3 class="phase-title">Deferred</h3>
        <ol class="milestone-list">
          {
            deferredIds.map((id) => {
              const m = byId.get(id);
              if (!m) return null;
              return (
                <li class="milestone-item state-deferred">
                  <details class="milestone-details">
                    <summary>
                      <span class="milestone-id">{m.id}</span>
                      <span class="milestone-name">{m.name}</span>
                      <span class="milestone-state" aria-label="State: Deferred">
                        <span class="state-icon" aria-hidden="true">—</span>
                        <span class="state-text">Deferred</span>
                      </span>
                    </summary>
                    <div class="milestone-body">
                      <p class="delivers">{m.delivers}</p>
                    </div>
                  </details>
                </li>
              );
            })
          }
        </ol>
      </section>
    </div>

    <p class="section-footer">
      <a class="button button-secondary" href={url('/roadmap')}>View full roadmap</a>
    </p>
  </div>
</section>

<style>
  .milestones-section {
    padding-block: var(--space-2xl);
  }

  .section-header {
    max-width: var(--measure);
    margin-block-end: var(--space-xl);
  }

  .section-header h2 {
    margin-block-end: var(--space-sm);
  }

  .phases {
    display: grid;
    gap: var(--space-lg);
    margin-block-end: var(--space-xl);
  }

  .phase {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: var(--space-md);
    align-items: start;
  }

  .phase-title {
    position: sticky;
    top: 5rem;
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 700;
    font-variation-settings: "wdth" var(--display-wdth), "wght" var(--display-wght);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--text);
    padding-block-start: var(--space-sm);
  }

  .phase-deferred .phase-title {
    color: var(--text-tertiary);
  }

  .milestone-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--border);
  }

  .milestone-item {
    border-bottom: 1px solid var(--border);
    background: var(--paper);
  }

  .milestone-item.state-next {
    background: var(--paper-elevated);
  }

  .milestone-item.is-active-next {
    border-inline-start: 3px solid var(--accent);
  }

  @media (prefers-color-scheme: dark) {
    .milestone-item.is-active-next {
      border-inline-start-color: var(--accent-on-dark);
    }
  }

  .milestone-details summary {
    display: grid;
    grid-template-columns: 3rem 1fr auto;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    cursor: pointer;
    list-style: none;
    font-family: var(--font-body);
    font-size: var(--text-sm);
  }

  .milestone-details summary::-webkit-details-marker {
    display: none;
  }

  .milestone-details summary:hover {
    background: var(--paper-sunk);
  }

  .milestone-id {
    font-family: var(--font-mono);
    color: var(--text-tertiary);
    font-variant-numeric: tabular-nums;
  }

  .milestone-name {
    color: var(--text);
  }

  .milestone-state {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-tertiary);
  }

  .state-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1rem;
    height: 1rem;
  }

  .milestone-item.state-done .state-icon {
    color: var(--text-secondary);
  }

  .milestone-item.state-next .state-icon {
    color: var(--accent);
  }

  .milestone-item.is-active-next .milestone-state {
    color: var(--accent);
    font-weight: 500;
  }

  @media (prefers-color-scheme: dark) {
    .milestone-item.state-next .state-icon,
    .milestone-item.is-active-next .milestone-state {
      color: var(--accent-on-dark);
    }
  }

  .milestone-body {
    padding: 0 var(--space-md) var(--space-md) calc(3rem + var(--space-md) + var(--space-sm));
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .milestone-body .delivers {
    margin-block-end: var(--space-sm);
  }

  .criterion {
    margin-block-start: var(--space-xs);
    max-width: var(--measure);
  }

  .criterion span {
    color: var(--text-tertiary);
  }

  .section-footer {
    display: flex;
    justify-content: flex-start;
  }

  @media (max-width: 760px) {
    .phase {
      grid-template-columns: 1fr;
      gap: var(--space-sm);
    }
    .phase-title {
      position: static;
      padding-block-start: var(--space-md);
    }
    .milestone-details summary {
      grid-template-columns: 2.5rem 1fr auto;
    }
    .milestone-body {
      padding-inline-start: var(--space-md);
    }
  }
</style>
