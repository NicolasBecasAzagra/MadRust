---
import { milestones } from '../data/project';
import { url } from '../lib/paths';

const stateLabel: Record<string, string> = {
  done: 'Done',
  next: 'Next',
  deferred: 'Deferred',
};

const phases = [
  {
    title: 'Kernel and memory',
    ids: ['M0', 'M1', 'M2', 'M2b', 'M2c', 'M3'],
  },
  {
    title: 'Userspace and paging',
    ids: ['M4', 'M4b', 'M4c', 'E1', 'E2', 'E2b', 'E3a', 'E3b'],
  },
  {
    title: 'Parallelism and network',
    ids: ['M9', 'M10', 'M12'],
  },
  {
    title: 'Inference, agent and measurement',
    ids: ['E4', 'E5', 'E6', 'E7', 'E8', 'M8', 'M11', 'M13'],
  },
];

const deferredIds = ['M5', 'M6', 'M7'];

const byId = new Map(milestones.map((m) => [m.id, m]));

const activeNextId = phases
  .flatMap((p) => p.ids)
  .find((id) => byId.get(id)?.state === 'next');
---

<section class="milestones-section" aria-labelledby="milestones-title">
  <div class="wrapper">
    <header class="section-header">
      <p class="section-eyebrow">Milestones</p>
      <h2 id="milestones-title" class="text-title">A ladder of exit criteria</h2>
      <p class="text-lead">
        Every milestone ends with a sentence a machine can check. No hand-waving, no “almost done”.
      </p>
    </header>

    <div class="phases">
      {
        phases.map((phase) => (
          <section class="phase">
            <h3 class="phase-title">{phase.title}</h3>
            <ol class="milestone-list">
              {phase.ids.map((id) => {
                const m = byId.get(id);
                if (!m) return null;
                const isActiveNext = m.state === 'next' && m.id === activeNextId;
                return (
                  <li class={`milestone-card state-${m.state} ${isActiveNext ? 'is-active-next' : ''}`}>
                    <div class="milestone-meta">
                      <span class="milestone-id">{m.id}</span>
                      <span class={`badge badge-${m.state} ${isActiveNext ? 'badge-active-next' : ''}`}>{stateLabel[m.state]}</span>
                    </div>
                    <h4>{m.name}</h4>
                    <p class="text-body">{m.delivers}</p>
                    {m.exit && (
                      <p class="milestone-exit">
                        <span>Exit:</span> {m.exit}
                      </p>
                    )}
                    {m.verification && (
                      <p class="milestone-verification">
                        <span>Verification:</span> {m.verification}
                      </p>
                    )}
                  </li>
                );
              })}
            </ol>
          </section>
        ))
      }

      <section class="phase phase-deferred">
        <h3 class="phase-title">Deferred</h3>
        <ol class="milestone-list">
          {
            deferredIds.map((id) => {
              const m = byId.get(id);
              if (!m) return null;
              return (
                <li class={`milestone-card state-${m.state}`}>
                  <div class="milestone-meta">
                    <span class="milestone-id">{m.id}</span>
                    <span class={`badge badge-${m.state}`}>{stateLabel[m.state]}</span>
                  </div>
                  <h4>{m.name}</h4>
                  <p class="text-body">{m.delivers}</p>
                </li>
              );
            })
          }
        </ol>
      </section>
    </div>

    <p class="section-footer">
      <a class="button button-secondary" href={url('/roadmap')}>View full roadmap</a>
    </p>
  </div>
</section>

<style>
  .milestones-section {
    padding-block: var(--space-2xl);
  }

  .section-eyebrow {
    margin-block-end: var(--space-sm);
    color: var(--text-tertiary);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
  }

  .phases {
    display: grid;
    gap: var(--space-lg);
    margin-block-end: var(--space-xl);
  }

  .phase {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: var(--space-md);
    align-items: start;
  }

  .phase-title {
    position: sticky;
    top: 5rem;
    font-size: var(--text-base);
    font-weight: var(--font-semibold);
    color: var(--text);
    padding-block-start: var(--space-sm);
  }

  .phase-deferred .phase-title {
    color: var(--text-tertiary);
  }

  .milestone-list {
    display: grid;
    gap: var(--space-sm);
    list-style: none;
    padding: 0;
  }

  .milestone-card {
    position: relative;
    padding: var(--space) var(--space-md);
    padding-inline-start: calc(var(--space-md) + 4px);
    border-radius: var(--radius);
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    overflow: hidden;
  }

  .milestone-card::before {
    content: '';
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    width: 4px;
    background: var(--border-strong);
  }

  .milestone-card.state-done::before {
    background: var(--border-strong);
  }

  .milestone-card.state-next::before {
    background: var(--border-strong);
  }

  .milestone-card.is-active-next::before {
    background: var(--accent);
  }

  @media (prefers-color-scheme: dark) {
    .milestone-card.is-active-next::before {
      background: var(--accent-on-dark);
    }
  }

  .milestone-card.state-deferred::before {
    background: transparent;
    border-inline-start: 2px dashed var(--border-strong);
  }

  .milestone-meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-block-end: 0.25rem;
  }

  .milestone-id {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-tertiary);
  }

  .badge {
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    font-size: var(--text-xs);
    font-weight: var(--font-medium);
  }

  .badge-done {
    background: var(--bg-sunk);
    color: var(--text-secondary);
    border: 1px solid var(--border);
  }

  .badge-next {
    background: var(--bg-sunk);
    color: var(--text-secondary);
    border: 1px solid var(--border);
  }

  .badge-active-next {
    background: var(--accent);
    color: var(--text-inverse);
    border-color: var(--accent);
  }

  @media (prefers-color-scheme: dark) {
    .badge-active-next {
      background: var(--accent-on-dark);
      color: var(--text);
      border-color: var(--accent-on-dark);
    }
  }

  .badge-deferred {
    background: transparent;
    color: var(--text-tertiary);
    border: 1px dashed var(--border-strong);
  }

  .milestone-card h4 {
    font-size: var(--text-lg);
    font-weight: var(--font-semibold);
    margin-block-end: 0.15rem;
  }

  .milestone-card .text-body {
    font-size: var(--text-sm);
    line-height: 1.55;
  }

  .milestone-exit,
  .milestone-verification {
    margin-block-start: var(--space-sm);
    font-size: var(--text-xs);
    color: var(--text-secondary);
  }

  .milestone-exit span,
  .milestone-verification span {
    color: var(--text-tertiary);
    font-weight: var(--font-medium);
  }

  .section-footer {
    display: flex;
    justify-content: center;
  }

  @media (max-width: 760px) {
    .phase {
      grid-template-columns: 1fr;
      gap: var(--space-sm);
    }
    .phase-title {
      position: static;
      padding-block-start: var(--space-md);
    }
  }
</style>
