---
import { faq } from '../data/project';
import { url } from '../lib/paths';
import FaqList from './faq/FaqList.astro';

const preview = faq.slice(0, 4);
---

<section class="faq-section" aria-labelledby="faq-title">
  <div class="wrapper">
    <header class="section-header">
      <h2 id="faq-title" class="text-title">What people ask</h2>
    </header>

    <FaqList items={preview} />

    <p class="section-footer">
      <a class="button button-secondary" href={url('/faq')}>Read all questions</a>
    </p>
  </div>
</section>

<style>
  .faq-section {
    padding-block: var(--space-2xl);
  }

  .section-header {
    max-width: var(--measure);
    margin-block-end: var(--space-xl);
  }

  .section-header h2 {
    margin-block-end: var(--space-sm);
  }

  .section-footer {
    display: flex;
    justify-content: flex-start;
    margin-block-start: var(--space-xl);
  }
</style>
