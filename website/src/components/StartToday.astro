---
import { meta, build } from '../data/project';
import { url } from '../lib/paths';
import TerminalBlock from './TerminalBlock.astro';

const cloneCommand = `git clone ${meta.repo}.git`;
---

<section class="start-section" aria-labelledby="start-title">
  <div class="wrapper">
    <header class="section-header">
      <h2 id="start-title" class="text-title">Run it today</h2>
      <p class="text-lead">
        Clone, build, boot. The repository has everything: the kernel, the runtime, the agent, the
        benchmark rig.
      </p>
    </header>

    <TerminalBlock code={cloneCommand} label="Clone the repository" />

    <div class="start-links">
      <a class="start-link" href={url('/download')}>
        <span class="link-label">Download & build</span>
        <span class="link-meta">{meta.toolchain} · {build.requirements[2].detail}</span>
      </a>
      <a class="start-link" href={url('/docs')}>
        <span class="link-label">Read the docs</span>
        <span class="link-meta">Architecture, boot protocol, benchmarking</span>
      </a>
      <a class="start-link" href={url('/changelog')}>
        <span class="link-label">Changelog</span>
        <span class="link-meta">What changed, what is next</span>
      </a>
    </div>

    <p class="qemu-note">
      Boot in QEMU with <code>make run</code>. The serial log ends with exit status 33 when the boot
      is clean.
    </p>
  </div>
</section>

<style>
  .start-section {
    padding-block: var(--space-2xl);
  }

  .section-header {
    max-width: var(--measure);
    margin-block-end: var(--space-xl);
  }

  .section-header h2 {
    margin-block-end: var(--space-sm);
  }

  .start-links {
    margin-block-start: var(--space-md);
    border-top: 1px solid var(--border);
  }

  .start-link {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    align-items: baseline;
    gap: var(--space-md);
    padding: var(--space-sm) 0;
    border-bottom: 1px solid var(--border);
    color: inherit;
    text-decoration: none;
  }

  .start-link:hover {
    background: var(--paper-elevated);
  }

  .start-link:hover .link-label {
    color: var(--accent);
  }

  @media (prefers-color-scheme: dark) {
    .start-link:hover .link-label {
      color: var(--accent-on-dark);
    }
  }

  .link-label {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: var(--font-bold);
    font-variation-settings: "wdth" var(--display-wdth), "wght" var(--display-wght);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--text);
  }

  .link-meta {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .qemu-note {
    margin-block-start: var(--space-md);
    padding: var(--space-sm) var(--space-md);
    border: 1px solid var(--border);
    background: var(--paper-elevated);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .qemu-note code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--text);
    background: var(--paper-sunk);
    padding: 0.1em 0.25em;
  }

  @media (max-width: 760px) {
    .start-link {
      grid-template-columns: 1fr;
      gap: var(--space-xs);
    }
  }
</style>
