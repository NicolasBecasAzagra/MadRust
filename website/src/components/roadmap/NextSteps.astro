---
import { nextSteps } from '../../data/project';
---

<section class="next-section" aria-labelledby="next-title">
  <div class="wrapper">
    <header class="section-header">
      <h2 id="next-title" class="text-title">What comes next</h2>
    </header>

    <ol class="next-list">
      {
        nextSteps.map((step, index) => (
          <li class="next-item">
            <div class="next-meta">
              <span class="next-number">{String(index + 1).padStart(2, '0')}</span>
              <h3>{step.title}</h3>
              {step.id && <span class="next-id">{step.id}</span>}
            </div>
            <p class="text-body">{step.why}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .next-section {
    padding-block: var(--space-2xl);
    background: var(--paper-elevated);
    border-block: 1px solid var(--border);
  }

  .section-header {
    max-width: var(--measure);
    margin-block-end: var(--space-xl);
  }

  .section-header h2 {
    margin-block-end: var(--space-sm);
  }

  .next-list {
    list-style: none;
    padding: 0;
    margin: 0;
    counter-reset: next;
  }

  .next-item {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: var(--space-md);
    padding: var(--space-md);
    border-bottom: 1px solid var(--border);
    background: var(--paper);
  }

  .next-item:first-child {
    border-top: 1px solid var(--border);
  }

  .next-number {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-tertiary);
    font-variant-numeric: tabular-nums;
  }

  .next-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-sm);
    margin-block-end: var(--space-xs);
  }

  .next-meta h3 {
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-weight: 700;
    font-variation-settings: "wdth" var(--display-wdth), "wght" var(--display-wght);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--text);
  }

  .next-id {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-tertiary);
    background: var(--paper-sunk);
    padding: 0.1rem 0.35rem;
  }

  .text-body {
    max-width: var(--measure);
  }

  @media (max-width: 760px) {
    .next-item {
      grid-template-columns: 1fr;
      gap: var(--space-xs);
    }
  }
</style>
