---
import { estimates } from '../../data/project';
---

<section class="estimate-section" aria-labelledby="estimate-title">
  <div class="wrapper">
    <div class="estimate-body">
      <h2 id="estimate-title" class="text-headline">Estimate</h2>
      <p class="text-lead">{estimates.effort}</p>
    </div>
  </div>
</section>

<style>
  .estimate-section {
    padding-block: var(--space-xl);
  }

  .estimate-body {
    max-width: var(--measure);
    padding: var(--space-lg);
    border: 1px solid var(--border);
    background: var(--paper-elevated);
  }

  .estimate-body h2 {
    margin-block-end: var(--space-sm);
  }
</style>
