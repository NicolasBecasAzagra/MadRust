---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import FaqList from '../components/faq/FaqList.astro';
import { meta, faq } from '../data/project';
import { url } from '../lib/paths';
---

<Base title="Frequently asked questions" description={meta.description}>
  <Nav />
  <main id="main" class="faq-page">
    <div class="wrapper">
      <header class="page-header">
        <h1 class="text-title">The questions people ask first</h1>
        <p class="text-lead">
          Short answers, with links to the repository and the documentation when the full context
          matters.
        </p>
      </header>

      <FaqList items={faq} />

      <p class="faq-more">
        If an answer is not here, it is probably in the
        <a href={url('/docs')}>documentation</a> or in the
        <a href={meta.repo}>repository</a>.
      </p>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .faq-page {
    padding-block: calc(4rem + var(--space-2xl)) var(--space-xl);
  }

  .page-header {
    max-width: var(--measure);
    margin-block-end: var(--space-xl);
  }

  .page-header h1 {
    margin-block-end: var(--space-sm);
  }

  .faq-more {
    margin-block-start: var(--space-xl);
    color: var(--text-secondary);
  }

  .faq-more a {
    color: var(--accent);
  }

  @media (prefers-color-scheme: dark) {
    .faq-more a {
      color: var(--accent-on-dark);
    }
  }
</style>
