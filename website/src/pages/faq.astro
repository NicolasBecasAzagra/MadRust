---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import FaqList from '../components/faq/FaqList.astro';
import { meta, faq } from '../data/project';
import { url } from '../lib/paths';
---

<Base title="Frequently asked questions" description={meta.description}>
  <Nav />
  <main id="main" class="faq-page">
    <div class="wrapper">
      <header class="page-header reveal">
        <p class="section-eyebrow">FAQ</p>
        <h1 class="text-title">The questions people ask first</h1>
      </header>

      <FaqList items={faq} />

      <p class="faq-more reveal">
        <span class="text-body">
          If an answer is not here, it is probably in the{' '}
          <a href={url('/docs')}>documentation</a>{' '}or in the{' '}
          <a href={meta.repo}>repository</a>.
        </span>
      </p>
    </div>
  </main>
  <Footer />
  <ScrollReveal />
</Base>

<style>
  .faq-page {
    padding-block: var(--space-2xl) var(--space-xl);
  }

  .page-header {
    margin-block-end: var(--space-xl);
  }

  .section-eyebrow {
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin-block-end: var(--space-sm);
  }

  .faq-more {
    margin-block-start: var(--space-xl);
    text-align: center;
  }

  .faq-more .text-body {
    color: var(--text-secondary);
  }
</style>
