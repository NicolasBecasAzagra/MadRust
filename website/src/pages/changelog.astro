---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import ChangelogList from '../components/changelog/ChangelogList.astro';
---

<Base title="Changelog" description="Every commit of the MadRust repository, grouped by month.">
  <Nav />
  <main id="main" class="changelog-page">
    <div class="wrapper">
      <header class="page-header reveal">
        <p class="section-eyebrow">History</p>
        <h1 class="text-title">Every commit of the repository, from the source of truth.</h1>
      </header>

      <ChangelogList />
    </div>
  </main>
  <Footer />
  <ScrollReveal />
</Base>

<style>
  .changelog-page {
    padding-block: var(--space-2xl) var(--space-xl);
  }

  .page-header {
    margin-block-end: var(--space-xl);
  }

  .section-eyebrow {
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin-block-end: var(--space-sm);
  }
</style>
