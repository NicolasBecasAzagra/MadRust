---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ChangelogList from '../components/changelog/ChangelogList.astro';
import { meta } from '../data/project';
---

<Base title="Changelog" description="Every commit of the MadRust repository, grouped by month.">
  <Nav />
  <main id="main" class="changelog-page">
    <div class="wrapper">
      <header class="page-header">
        <h1 class="text-title">Every commit of the repository</h1>
        <p class="text-lead">
          Built from the git log at build time. Each line links to the commit on GitHub.
        </p>
      </header>

      <ChangelogList />

      <p class="changelog-source">
        <a href={meta.repo}>View the repository on GitHub</a>
      </p>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .changelog-page {
    padding-block: calc(4rem + var(--space-2xl)) var(--space-xl);
  }

  .page-header {
    max-width: var(--measure);
    margin-block-end: var(--space-xl);
  }

  .page-header h1 {
    margin-block-end: var(--space-sm);
  }

  .changelog-source {
    margin-block-start: var(--space-xl);
  }
</style>
