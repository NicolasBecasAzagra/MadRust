---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import MilestoneLadder from '../components/roadmap/MilestoneLadder.astro';
import NextSteps from '../components/roadmap/NextSteps.astro';
import Deferred from '../components/roadmap/Deferred.astro';
import RisksAndStopRules from '../components/roadmap/RisksAndStopRules.astro';
import Estimate from '../components/roadmap/Estimate.astro';
import { url } from '../lib/paths';

const title = 'Roadmap';
const description =
  'The milestone ladder of MadRust: exit criteria a machine can check, what comes next, the risks, and the stop rules.';
---

<Base title={title} description={description}>
  <Nav />
  <main id="main">
    <section class="page-hero" aria-labelledby="roadmap-title">
      <div class="wrapper">
        <header class="section-header">
          <h1 id="roadmap-title" class="text-display">Every milestone has an exit criterion</h1>
          <p class="text-lead">
            Each step ends with a sentence a machine can check, not a feeling or a demo. The state
            of the ladder is the state of the project.
          </p>
        </header>
      </div>
    </section>

    <MilestoneLadder />
    <NextSteps />
    <Deferred />
    <RisksAndStopRules />
    <Estimate />

    <section class="cta-section" aria-labelledby="roadmap-cta-title">
      <div class="wrapper">
        <div class="cta-inner">
          <h2 id="roadmap-cta-title" class="text-headline">Read the design</h2>
          <p class="text-body">
            The architecture document explains why the milestones are ordered this way and how each
            crate fits in.
          </p>
          <div class="cta-actions">
            <a class="button button-secondary" href={url('/docs/architecture')}>Architecture</a>
            <a class="button button-secondary" href={url('/benchmarks')}>Benchmarks</a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <ScrollReveal />
</Base>

<style>
  .page-hero {
    padding-block-start: calc(3.5rem + var(--space-2xl));
    padding-block-end: var(--space-xl);
  }

  .section-header {
    max-width: var(--measure);
  }

  .section-header h1 {
    margin-block-end: var(--space-md);
  }

  .cta-section {
    padding-block: var(--space-2xl);
  }

  .cta-inner {
    max-width: var(--measure);
    padding: var(--space-lg);
    border: 1px solid var(--border);
    background: var(--paper-elevated);
  }

  .cta-inner h2 {
    margin-block-end: var(--space-sm);
  }

  .cta-inner p {
    margin-block-end: var(--space-md);
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }
</style>
