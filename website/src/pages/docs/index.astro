---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import DocsGrid from '../../components/docs/DocsGrid.astro';
---

<Base title="Documentation" description="Read the architecture, boot protocol, benchmarking method and measurement report of MadRust.">
  <Nav />
  <main id="main" class="docs-index">
    <div class="wrapper">
      <header class="page-header">
        <h1 class="text-title">Read the system</h1>
        <p class="text-lead">
          The documents that explain how MadRust is built, measured and run.
        </p>
      </header>

      <DocsGrid />
    </div>
  </main>
  <Footer />
</Base>

<style>
  .docs-index {
    padding-block: calc(4rem + var(--space-2xl)) var(--space-xl);
  }

  .page-header {
    max-width: var(--measure);
    margin-block-end: var(--space-xl);
  }

  .page-header h1 {
    margin-block-end: var(--space-sm);
  }
</style>
